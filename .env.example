# Copy to .env and fill in. NEVER commit the real .env file.

# --- Discord bot ---------------------------------------------------------
DISCORD_TOKEN=put-your-bot-token-here
# Optional: the guild (server) the bot serves; leave blank to serve any guild it is in.
DISCORD_GUILD_ID=

# --- Shared storage ------------------------------------------------------
# Paths are resolved on the server only and are never shown in the portal.
DATABASE_PATH=data/dark_asylum.sqlite3
ARCHIVE_DIR=data/archive
# Primary backup folder (same server) and a SEPARATE drive/mount for the second copy.
BACKUP_DIR=backups/primary
BACKUP_SECONDARY_DIR=/mnt/second-drive/dark_asylum_backups

# --- Portal --------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Exactly TWO Discord user IDs allowed to ever have portal access (comma separated).
PORTAL_ADMIN_DISCORD_IDS=111111111111111111,222222222222222222
# Bind to loopback; a reverse proxy (Caddy/nginx) terminates HTTPS in front.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8080
# Keep "true" in production. Only set "false" for plain-HTTP local development.
PORTAL_SECURE_COOKIES=true
# Number of reverse proxies in front of the portal (for correct client IPs).
PORTAL_TRUSTED_PROXIES=1

# --- RS3 public data ---------------------------------------------------------
# No API keys are needed. Set to "true" to disable all outbound RS3 API calls.
RS3_API_DISABLED=false
